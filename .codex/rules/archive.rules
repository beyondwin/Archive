# Archive project command rules.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard user work. Ask for explicit destructive-git approval and use a reversible alternative when possible.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Cleaning untracked files can delete user work; confirm scope before running.",
    match = [
        "git clean -fd",
        "git clean -fdx",
    ],
    not_match = [
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force push can overwrite remote history; use an explicitly approved safer workflow.",
)

prefix_rule(
    pattern = ["git", "push", "--force-with-lease"],
    decision = "prompt",
    justification = "History rewrite requires explicit authorization and a fresh remote check.",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Short force push can overwrite remote history; use an explicitly approved safer workflow.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Prompt for other push spellings because execpolicy prefix rules cannot inspect arbitrary later or equals-form force options.",
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "Forced branch deletion can discard unmerged work.",
)

prefix_rule(
    pattern = ["git", "branch", "--delete"],
    decision = "prompt",
    justification = "Branch deletion can discard unmerged work even when force is a later option.",
)

prefix_rule(
    pattern = ["git", "branch", "-d"],
    decision = "prompt",
    justification = "Branch deletion can discard unmerged work even when force is a later option.",
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Worktree removal must confirm the exact target and preserve active work.",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Recursive deletion needs an explicit scope check.",
    match = [
        "rm -rf tmp",
        "rm -rf /tmp/example",
    ],
    not_match = [
        "rm file.txt",
    ],
)
