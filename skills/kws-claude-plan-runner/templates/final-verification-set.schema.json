{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_head": {},
    "commands": {},
    "kind": {},
    "rationale": {}
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "candidate_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "commands": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "argv": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
              "command_id": {"minLength": 1, "type": "string"},
              "command_role": {"const": "final"},
              "cwd": {"minLength": 1, "type": "string"},
              "deadline_seconds": {"exclusiveMinimum": 0, "type": "number"},
              "input_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
            },
            "required": ["command_id", "command_role", "argv", "cwd", "input_digest", "deadline_seconds"],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {"const": "commands"}
      },
      "required": ["kind", "candidate_head", "commands"],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "candidate_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "kind": {"const": "no_applicable_verification"},
        "rationale": {"minLength": 1, "type": "string"}
      },
      "required": ["kind", "candidate_head", "rationale"],
      "type": "object"
    }
  ],
  "type": "object"
}
