{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex plan handoff result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "head_commit", "summary", "verification_set_digest", "blocker"],
  "properties": {
    "status": {"enum": ["implemented", "blocked"]},
    "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "summary": {"type": "string"},
    "verification_set_digest": {"type": ["string", "null"]},
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {"enum": ["credentials_unavailable", "destructive_authorization_required", "external_authority_required", "external_state_unavailable", "irreconcilable_requirements", "permission_required", "provider_auth_blocked", "provider_unavailable", "provider_usage_blocked"]},
        "detail": {"type": "string"}
      }
    }
  }
}
