{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex plan implementation result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "head_commit",
        "summary",
        "task_ledger",
        "open_obligation_ids",
        "failure_signature",
        "strategy_note"
      ],
      "properties": {
        "status": {"const": "implemented"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "task_ledger": {"$ref": "#/$defs/implementedTaskLedger"},
        "open_obligation_ids": {"type": "array", "maxItems": 0},
        "failure_signature": {"type": "null"},
        "strategy_note": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 4096}
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "head_commit",
        "summary",
        "task_ledger",
        "open_obligation_ids",
        "failure_signature",
        "strategy_note",
        "blocker"
      ],
      "properties": {
        "status": {"const": "blocked"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "task_ledger": {"$ref": "#/$defs/taskLedger"},
        "open_obligation_ids": {"$ref": "#/$defs/identifierList"},
        "failure_signature": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "strategy_note": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 4096}
          ]
        },
        "blocker": {"$ref": "#/$defs/blocker"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "head_commit",
        "summary",
        "task_ledger",
        "open_obligation_ids",
        "failure_signature",
        "strategy_note"
      ],
      "properties": {
        "status": {"const": "failed"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "task_ledger": {"$ref": "#/$defs/taskLedger"},
        "open_obligation_ids": {"$ref": "#/$defs/identifierList"},
        "failure_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "strategy_note": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identifierList": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "taskLedger": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status", "evidence_digests"],
        "properties": {
          "task_id": {"$ref": "#/$defs/identifier"},
          "status": {"enum": ["pending", "running", "reported_done"]},
          "evidence_digests": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "implementedTaskLedger": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "status", "evidence_digests"],
        "properties": {
          "task_id": {"$ref": "#/$defs/identifier"},
          "status": {"const": "reported_done"},
          "evidence_digests": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "credentials_unavailable",
            "destructive_authorization_required",
            "external_authority_required",
            "external_state_unavailable",
            "irreconcilable_requirements",
            "permission_required",
            "provider_auth_blocked",
            "provider_unavailable",
            "provider_usage_blocked"
          ]
        },
        "detail": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  }
}
