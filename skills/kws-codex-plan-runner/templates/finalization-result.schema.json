{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex whole-branch finalization result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "review_head",
    "verification_set_digest",
    "open_findings",
    "open_obligation_ids",
    "no_applicable_verification_approved",
    "summary"
  ],
  "properties": {
    "status": {"const": "reviewed"},
    "review_head": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "verification_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "open_findings": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "severity": {"enum": ["Critical", "Important", "Minor"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "open_obligation_ids": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "no_applicable_verification_approved": {"type": "boolean"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}
