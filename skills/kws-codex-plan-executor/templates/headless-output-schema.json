{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "run_id",
    "state_path",
    "summary",
    "changed_files",
    "verification",
    "open_gaps",
    "residual_risk",
    "context_artifacts",
    "next_action"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "blocked", "failed"]
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "state_path": {
      "type": ["string", "null"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "open_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "residual_risk": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_manifest_path", "task_packet_dir", "decisions_path"],
      "properties": {
        "spec_manifest_path": {
          "type": ["string", "null"]
        },
        "task_packet_dir": {
          "type": ["string", "null"]
        },
        "decisions_path": {
          "type": ["string", "null"]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "summary", "recoverable", "next_action", "evidence_refs"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["preflight", "environment", "transient", "implementation", "review", "verification", "policy_violation", "state_integrity", "operator_review"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "recoverable": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "failure_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "decision", "reason", "recoverable", "next_action", "evidence_refs"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["preflight", "environment", "transient", "implementation", "review", "verification", "policy_violation", "state_integrity", "operator_review"]
        },
        "decision": {
          "type": "string",
          "enum": ["failed", "block", "fail"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recoverable": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "success"}}
      },
      "then": {
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "state_path": {"type": "string", "minLength": 1}
        },
        "not": {
          "anyOf": [
            {"required": ["blocker"]},
            {"required": ["failure_decision"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "blocked"}}
      },
      "then": {
        "required": ["blocker"],
        "not": {"required": ["failure_decision"]}
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "failed"}}
      },
      "then": {
        "required": ["failure_decision"],
        "not": {"required": ["blocker"]}
      }
    }
  ]
}
