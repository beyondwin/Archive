{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "optimization-report.schema.json",
  "title": "CPE optimization report",
  "type": "object",
  "required": ["format_version", "run_id", "usage", "duration_ms", "recovery_metrics", "findings"],
  "properties": {
    "format_version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "usage": {
      "type": "object",
      "required": ["observed_input_tokens", "unknown_attempt_count", "total_kind"],
      "properties": {
        "observed_input_tokens": {"type": "integer", "minimum": 0},
        "unknown_attempt_count": {"type": "integer", "minimum": 0},
        "total_kind": {"enum": ["exact", "lower_bound"]}
      },
      "additionalProperties": false
    },
    "duration_ms": {"type": "integer", "minimum": 0},
    "recovery_metrics": {
      "type": "object",
      "required": ["launches_avoided", "envelope_repairs", "productive_timeouts", "no_progress_slices", "budget_stops", "continuation_reason_counts"],
      "properties": {
        "launches_avoided": {"type": "integer", "minimum": 0},
        "envelope_repairs": {"type": "integer", "minimum": 0},
        "productive_timeouts": {"type": "integer", "minimum": 0},
        "no_progress_slices": {"type": "integer", "minimum": 0},
        "budget_stops": {"type": "integer", "minimum": 0},
        "continuation_reason_counts": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["signal", "source", "evidence_refs"],
        "properties": {
          "signal": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "source": {"enum": ["parent_observed", "child_attested", "derived", "hypothesis"]},
          "impact": {"type": "string", "minLength": 1, "maxLength": 2000},
          "action": {"type": "string", "minLength": 1, "maxLength": 2000},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 2000},
          "recurrence": {"type": "string", "minLength": 1, "maxLength": 2000},
          "recommendation": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
