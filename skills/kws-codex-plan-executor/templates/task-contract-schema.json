{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waygent.local/schemas/cpe-task-contract-v4.json",
  "title": "CPE TaskContractV4 canonical digest body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "task_type",
    "risk_class",
    "dependencies",
    "task_source",
    "task_source_sha256",
    "spec_sections",
    "file_claims",
    "forbidden_paths",
    "acceptance_commands",
    "required_methods",
    "required_evidence",
    "checkpoint_message",
    "source_hashes"
  ],
  "properties": {
    "schema_version": {"const": "cpe.task-contract.v4"},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "task_type": {
      "enum": [
        "tdd_implementation",
        "non_tdd_implementation",
        "documentation",
        "verification",
        "external_effect",
        "release_closeout"
      ]
    },
    "risk_class": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "task_source": {"type": "string", "minLength": 1},
    "task_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text": {"type": "string"}
        }
      }
    },
    "file_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_methods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "checkpoint_message": {"type": "string", "minLength": 1},
    "source_hashes": {"type": "object"}
  }
}
