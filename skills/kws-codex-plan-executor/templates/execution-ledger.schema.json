{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution-ledger.schema.json",
  "title": "CPE execution ledger event",
  "type": "object",
  "required": ["schema_version", "event_id", "source", "plan_id", "category", "action", "result", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "source": {"enum": ["parent_observed", "child_attested", "derived", "hypothesis"]},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "category": {"enum": ["task", "review", "finding_fix", "verification", "capability", "checkpoint", "blocker", "obligation", "coordination"]},
    "action": {"enum": ["recorded", "started", "completed", "failed", "blocked", "resolved", "approved", "rejected", "verified", "observed", "created", "updated", "checked", "satisfied", "waived", "requested", "responded", "executed_uncached"]},
    "result": {"enum": ["pass", "fail", "blocked", "skipped", "unavailable", "accepted", "closed"]},
    "evidence_refs": {"type": "array", "maxItems": 128, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}}
  },
  "allOf": [
    {"if": {"properties": {"category": {"const": "task"}}}, "then": {"required": ["task_id", "duration_ms"], "properties": {"task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "duration_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"category": {"const": "review"}}}, "then": {"required": ["review_id", "artifact_digest", "duration_ms"], "properties": {"review_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"category": {"const": "finding_fix"}}}, "then": {"required": ["finding_ids", "fix_digest", "duration_ms"], "properties": {"finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}, "fix_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration_ms": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"category": {"const": "verification"}}}, "then": {"oneOf": [
      {"properties": {"action": {"not": {"const": "executed_uncached"}}, "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "argv_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration_ms": {"type": "integer", "minimum": 0}}, "required": ["command_id", "argv_digest", "evidence_key", "duration_ms"]},
      {"properties": {"action": {"const": "executed_uncached"}, "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "argv_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration_ms": {"type": "integer", "minimum": 0}, "exit_code": {"type": "integer"}, "receipt_path": {"type": "null"}, "reason_code": {"enum": ["uncached_command_required", "verification_helper_fallback"]}, "phase": {"enum": ["task", "affected", "branch_final"]}, "evidence_refs": {"maxItems": 0}}, "required": ["command_id", "argv_digest", "evidence_key", "duration_ms", "exit_code", "receipt_path", "reason_code", "phase"]}
    ]}},
    {"if": {"properties": {"category": {"const": "capability"}}}, "then": {"required": ["capability_id", "capability_digest"], "properties": {"capability_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"category": {"const": "checkpoint"}}}, "then": {"required": ["checkpoint_id", "checkpoint_digest"], "properties": {"checkpoint_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"category": {"const": "blocker"}}}, "then": {"required": ["blocker_id", "blocker_digest"], "properties": {"blocker_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "blocker_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"category": {"const": "obligation"}}}, "then": {"required": ["obligation_id", "obligation_digest"], "properties": {"obligation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "obligation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    {"if": {"properties": {"category": {"const": "coordination"}}}, "then": {"required": ["coordination_id", "coordination_digest", "duration_ms"], "properties": {"coordination_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "coordination_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "duration_ms": {"type": "integer", "minimum": 0}}}}
  ],
  "unevaluatedProperties": false
}
