{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "summary",
    "changed_files",
    "findings",
    "evidence_refs",
    "missing_evidence",
    "verification",
    "verdict",
    "method_evidence_ref",
    "root_cause_key",
    "failure_category"
  ],
  "properties": {
    "status": {"enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string", "maxLength": 2000},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "severity", "summary", "action"],
        "properties": {
          "task_id": {"type": "string"},
          "severity": {"type": "string"},
          "summary": {"type": "string"},
          "action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "method_evidence_ref": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["kind", "path", "sha256", "media_type"],
          "properties": {
            "kind": {"const": "method_evidence"},
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "media_type": {"const": "application/json"}
          },
          "additionalProperties": false
        }
      ]
    },
    "root_cause_key": {"type": ["string", "null"]},
    "failure_category": {"type": ["string", "null"]},
    "verdict": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "status",
            "findings",
            "missing_evidence",
            "worktree_revision",
            "owner",
            "resume_condition",
            "next_evidence_action"
          ],
          "properties": {
            "status": {
              "enum": ["passed", "changes_requested", "blocked", "inconclusive"]
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["task_id", "severity", "summary", "action"],
                "properties": {
                  "task_id": {"type": "string"},
                  "severity": {"type": "string"},
                  "summary": {"type": "string"},
                  "action": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "missing_evidence": {"type": "array", "items": {"type": "string"}},
            "worktree_revision": {"type": "integer", "minimum": 0},
            "owner": {"type": ["string", "null"]},
            "resume_condition": {"type": ["string", "null"]},
            "next_evidence_action": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
