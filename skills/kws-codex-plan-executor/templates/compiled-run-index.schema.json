{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPE compiled run index",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "cache_key", "plans"],
  "properties": {
    "format_version": {"const": 2},
    "cache_key": {"$ref": "#/$defs/digest"},
    "plans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plan"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "order", "source_line_start", "source_line_end", "source_text_sha256"],
      "properties": {
        "task_id": {"$ref": "#/$defs/identifier"}, "order": {"type": "integer", "minimum": 0},
        "source_line_start": {"type": "integer", "minimum": 1}, "source_line_end": {"type": "integer", "minimum": 1},
        "source_text_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "argv", "allowed_branch_phases", "deterministic", "mutable_input_policy", "required_artifacts", "source_line_start", "source_line_end", "source_text_sha256"],
      "properties": {
        "command_id": {"$ref": "#/$defs/identifier"},
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
        "allowed_branch_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["task_red", "task_green", "final_verification"]}},
        "deterministic": {"type": "boolean"},
        "mutable_input_policy": {"enum": ["forbidden", "declared_external_state"]},
        "required_artifacts": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePath"}},
        "source_line_start": {"type": "integer", "minimum": 1}, "source_line_end": {"type": "integer", "minimum": 1},
        "source_text_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "task_ids"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identifier"},
        "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "source_sha256", "byte_length", "line_count", "tasks", "verifications", "capabilities", "execution_advisories", "unknowns"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan-[0-9]{2,}$"}, "source_sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {"type": "integer", "minimum": 0}, "line_count": {"type": "integer", "minimum": 0},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
        "verifications": {"type": "array", "items": {"$ref": "#/$defs/verification"}},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
        "execution_advisories": {"type": "array", "uniqueItems": true, "items": {"enum": ["split_or_checkpoint_required", "handoff_to_waygent"]}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    }
  }
}
