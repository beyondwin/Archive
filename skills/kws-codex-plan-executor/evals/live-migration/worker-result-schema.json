{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpe.live-migration.worker-result.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "finding_ids",
    "fact_ids",
    "block_ids",
    "changed_files"
  ],
  "properties": {
    "status": {"enum": ["completed", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "finding_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "fact_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "block_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
