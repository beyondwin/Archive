#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

if ! command -v uv >/dev/null 2>&1; then
  printf '%s\n' 'plan runner parity: BLOCKED (uv is not available)'
  exit 3
fi

if ! PYTHON_BIN=$(uv python find --managed-python --no-python-downloads \
  --no-project --no-config --resolve-links 3.13 2>/dev/null); then
  printf '%s\n' 'plan runner parity: BLOCKED (managed CPython 3.13 is not installed)'
  exit 3
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/check-plan-runner-parity.py" "$@"
