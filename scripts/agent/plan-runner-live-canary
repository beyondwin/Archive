#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

PROVIDER=
MODE=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider)
      [ "$#" -ge 2 ] || break
      [ -z "$PROVIDER" ] || break
      PROVIDER=$2
      shift 2
      ;;
    --mode)
      [ "$#" -ge 2 ] || break
      [ -z "$MODE" ] || break
      MODE=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

case "$PROVIDER" in codex|claude|all) ;; *) PROVIDER=invalid ;; esac
case "$MODE" in session|runner|ownership|interruption|all) ;; *) MODE=invalid ;; esac
if [ "$#" -ne 0 ] || [ "$PROVIDER" = invalid ] || [ "$MODE" = invalid ]; then
  printf '%s\n' \
    '{"provider":"invalid","mode":"invalid","status":"failed","provider_version":null,"session_action":"not_started","final_head":null,"elapsed_seconds":0.0,"reason_code":"invalid_invocation"}'
  exit 64
fi

emit_runtime_missing() {
  if [ "$PROVIDER" = all ]; then
    PROVIDERS="codex claude"
  else
    PROVIDERS=$PROVIDER
  fi
  if [ "$MODE" = all ]; then
    MODES="session runner"
  else
    MODES=$MODE
  fi
  for provider in $PROVIDERS; do
    for mode in $MODES; do
      printf '%s\n' \
        "{\"provider\":\"$provider\",\"mode\":\"$mode\",\"status\":\"blocked\",\"provider_version\":null,\"session_action\":\"not_started\",\"final_head\":null,\"elapsed_seconds\":0.0,\"reason_code\":\"runtime_missing\"}"
    done
  done
}

if ! command -v uv >/dev/null 2>&1; then
  emit_runtime_missing
  exit 3
fi

if ! PYTHON_BIN=$(uv python find --managed-python --no-python-downloads \
  --no-project --no-config --resolve-links 3.13 2>/dev/null); then
  emit_runtime_missing
  exit 3
fi

UV_PYTHON_INSTALL_DIR=$(dirname -- "$(dirname -- "$(dirname -- "$PYTHON_BIN")")")
export UV_PYTHON_INSTALL_DIR

exec "$PYTHON_BIN" "$SCRIPT_DIR/plan-runner-live-canary.py" \
  --provider "$PROVIDER" --mode "$MODE"
